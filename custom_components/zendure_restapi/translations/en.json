{
  "config": {
    "step": {
      "user": {
        "title": "Zendure RestAPI",
        "description": "What would you like to add?",
        "menu_options": {
          "zendure": "Zendure device (battery or P1 meter)",
          "external_meter": "External P1 meter (HomeWizard, YouLess, EcoTracker, Shelly)",
          "ha_sensor": "Home Assistant sensor as external meter (Zonneplan, DSMR, …)",
          "price_control": "Price control (dynamic tariffs)"
        }
      },
      "zendure": {
        "title": "Zendure device",
        "description": "Enter the IP address of the Zendure device. The local API must be enabled: in the Zendure app add HEMS, then exit the app.",
        "data": {
          "host": "IP address",
          "port": "HTTP port",
          "create_dashboard": "Create the Zendure RestAPI dashboard (battery only)"
        }
      },
      "confirm": {
        "title": "Zendure device found",
        "description": "Add {model} at {host} (serial {sn})?",
        "data": {
          "create_dashboard": "Create the Zendure RestAPI dashboard"
        }
      },
      "external_meter": {
        "title": "External P1 meter",
        "description": "A second grid meter for the battery controller. Which meter is used is chosen with the Meter source select on the battery (default: auto). HomeWizard: switch on Local API in the HomeWizard Energy app first.",
        "data": {
          "external_meter_type": "Meter type",
          "host": "IP address",
          "external_meter_interval_ms": "Milliseconds between polls (100-1000; below 1000 only for YouLess)"
        }
      },
      "homewizard_confirm": {
        "title": "HomeWizard P1 meter found",
        "description": "Use the HomeWizard P1 meter at {host} (serial {serial}) as grid meter for the battery? Local API must be switched on in the HomeWizard Energy app."
      },
      "ha_sensor": {
        "title": "Home Assistant sensor",
        "description": "A power sensor already in Home Assistant, import positive. With separate import and export sensors, both positive, also choose the export sensor. A sensor that updates less than once a second shows as stale between updates; Meter source auto then uses the Zendure meter.",
        "data": {
          "source_entity": "Power sensor (import positive)",
          "export_entity": "Export sensor (optional, export positive)"
        }
      },
      "price_control": {
        "title": "Price control",
        "description": "Sets the Operation mode of a battery from the electricity price: with two fixed prices, or with a day plan over the Nord Pool prices of today and tomorrow. It is off until you switch it on.",
        "data": {
          "battery_entry": "Battery",
          "price_entity": "Price sensor (price per kWh)",
          "price_contains": "The price sensor holds"
        },
        "data_description": {
          "price_contains": "For the day plan. Nord Pool (HACS) with VAT on and no additional costs: spot price incl. VAT. With VAT off: spot price. With your whole tariff in its additional costs: import price."
        }
      }
    },
    "error": {
      "cannot_connect": "No response. Check the IP address and that the local API is enabled.",
      "no_identity": "The device answered but reported neither a serial number nor a device id.",
      "wrong_meter_type": "The address answers, but not as this meter type. Check the meter type.",
      "homewizard_api_off": "The meter does not answer. Switch on Local API in the HomeWizard Energy app and try again.",
      "not_a_power_sensor": "This sensor has no power reading right now (unit W or kW, numeric state).",
      "same_entity": "The export sensor must differ from the power sensor."
    },
    "abort": {
      "already_configured": "This device is already configured.",
      "cannot_connect": "No response. Check the IP address and that the local API is enabled.",
      "no_identity": "The device answered but reported neither a serial number nor a device id.",
